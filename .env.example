# Copy this file to .env and fill in your own values. Never commit .env itself.

# Wallet private key used to deploy (use a fresh throwaway testnet wallet, not your main one)
PRIVATE_KEY=

# Optional: override the default public Arbitrum Sepolia RPC
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# For contract verification (Etherscan API V2 - one key works for Arbiscan too)
# Get one at https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=